# Java / Maven
backend/target/
*.class

# Node / frontend
frontend/node_modules/
frontend/dist/

# Env & secrets — never commit real secrets
.env
*.local

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# TLS certs/keys — never commit (generated by deploy/tls/gen-cert.sh)
deploy/tls/server.crt
deploy/tls/server.key

# Backup output (DB dumps) — never commit
backups/

# Playwright MCP debug artifacts (screenshots/snapshots taken during dev sessions)
.playwright-mcp/
