# Copy to .env and adjust. NEVER commit the real .env.
# docker-compose reads these; the backend also reads them directly when run locally.

# --- Database ---
# Admin/owner runs migrations (creates tables, enables + FORCEs RLS). Runtime connects as a
# NON-superuser role (mft_app) so row-level security actually enforces tenant isolation.
# The mft_app role is provisioned by db/init/01-app-role.sql (compose mounts it automatically).
DB_PASSWORD=mft                 # admin/owner password (POSTGRES_USER=mft)
# Change mft_app's password (in db/init/01-app-role.sql) before production.

# --- Object storage (MinIO / S3) ---
MINIO_USER=mftminio
MINIO_PASSWORD=change-me-strong-password

# --- Security (MUST override before any real deployment) ---
# Generate a strong secret:  openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktaW5zZWN1cmUtc2VjcmV0LWNoYW5nZS1tZS1iZWZvcmUtcHJvZC0xMjM0NTY3OA==

# --- CORS: the frontend origin(s), comma-separated ---
CORS_ORIGINS=http://localhost:5173

# --- First-run bootstrap (change the password!) ---
BOOTSTRAP_ADMIN_EMAIL=admin@cloudfuze.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
BOOTSTRAP_TENANT_SLUG=demo
BOOTSTRAP_TENANT_NAME=CloudFuze Demo

# --- Credential vault master key (AES-256): base64 of EXACTLY 32 bytes ---
# Generate:  openssl rand -base64 32    (in production, source from KMS/Vault, not env)
MFT_CRED_KEY=ZGV2LW9ubHktY3JlZC1rZXktY2hhbmdlLW1lISEzMmI=

# --- SSO (OIDC). Point at your IdP; leave disabled to use password login only. ---
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
